{
	"name": "belisoful/prado-mongodb",
	"type": "prado4-extension",
	"description": "MongoDB driver for the PRADO Data layer: connection, command, reader, transaction, metadata, command builder, collection gateway, ActiveRecord support and a MongoDB cache module",
	"keywords": [ "prado", "framework", "extension", "mongodb", "database", "activerecord", "cache"],
	"homepage": "https://github.com/belisoful/prado-mongodb",
	"license": "MIT",
	"authors": [
		{
			"name": "Brad Anderson",
			"email": "belisoful@icloud.com",
			"role": "Developer",
			"homepage": "https://github.com/belisoful"
		}
	],
	"autoload": {
		"psr-4": {
			"Prado\\": "src"
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		},
		{
			"type": "path",
			"url": "../prado",
			"options": {
				"symlink": true
			}
		}
	],
	"require": {
		"php": ">=8.1.0",
		"mongodb/mongodb" : "^2.1",
		"pradosoft/prado" : "^4.3.3@dev"
	},
	"require-dev" : {
		"phpunit/phpunit" : "^10",
		"phpdocumentor/shim": "^3",
		"friendsofphp/php-cs-fixer": "^3.94",
		"phpstan/phpstan": "^2.1"
	},
	"suggest" : {
		"pradosoft/prado-activerecord" : "Scaffold inputs for ActiveRecord forms on MongoDB connections (TMongoScaffoldInput)"
	},
	"config": {
		"allow-plugins": {
			"phpdocumentor/shim": true
		}
	},
	"scripts": {
		"unittest": "vendor/bin/phpunit --testsuite unit"
	},
	"extra": {
		"bootstrap": "Prado\\Data\\TMongoSourceConfig",
		"prado": {
			"bootstrap": "Prado\\Data\\TMongoSourceConfig",
			"error-messages": "src/errorMessages.txt"
		}
	}
}
